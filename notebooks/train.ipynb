   "source": [
    "# Generate emojis from text prompts\n",
    "import subprocess\n",
    "import os\n",
    "\n",
    "os.makedirs('/content/pixmoji/generated', exist_ok=True)\n",
    "\n",
    "prompts = [\n",
    "    \"a cute robot\",\n",
    "    \"a smiling face\",\n",
    "    \"a rocket ship\",\n",
    "]\n",
    "\n",
    "print(\"🎨 Generating Emojis\")\n",
    "print(\"=\" * 50)\n",
    "\n",
    "for prompt in prompts:\n",
    "    print(f\"\\n🔮 Prompt: '{prompt}'\")\n",
    "    \n",
    "    cmd = [\n",
    "        \"python\", \"-c\", f'''\n",
    "import sys\n",
    "sys.path.insert(0, \"/content/pixmoji\")\n",
    "\n",
    "from src.inference.generate import Generator, save_images\n",
    "\n",
    "generator = Generator(\"/content/pixmoji/checkpoints/model_final.pt\")\n",
    "images = generator.generate(\"{prompt}\", num_samples=4, num_steps=50)\n",
    "save_images(images, \"/content/pixmoji/generated\", prefix=\"{prompt.replace(' ', '_')}\")\n",
    "'''\n",
    "    ]\n",
    "    \n",
    "    subprocess.run(cmd, cwd=\"/content/pixmoji\", capture_output=True)\n",
    "\n",
    "print(\"\\n\" + \"=\" * 50)\n",
    "print(\"✅ Generation complete!\")"
   ]
