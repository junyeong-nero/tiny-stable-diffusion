    "%%writefile /content/pixmoji/src/inference/generate.py\n",
    "\"\"\"Inference script for generating images.\"\"\"\n",
    "\n",
    "from __future__ import annotations\n",
    "\n",
    "import math\n",
    "import os\n",
    "from pathlib import Path\n",
    "\n",
    "import torch\n",
    "from tqdm import tqdm\n",
    "\n",
    "from src.config import ModelConfig\n",
    "from src.models.dit import DiT\n",
    "from src.models.diffusion import Diffusion\n",
    "from src.text_encoder.clip_encoder import CLIPTextEncoder\n",
    "\n",
    "\n",
    "class Generator:\n",
    "    \"\"\"Image generator using trained diffusion model.\"\"\"\n",
    "\n",
    "    def __init__(self, checkpoint_path: str, device: str = \"cuda\") -> None:\n",
    "        self.device = torch.device(device if torch.cuda.is_available() else \"cpu\")\n",
    "        print(f\"Using device: {self.device}\")\n",
    "\n",
    "        # Load checkpoint\n",
    "        checkpoint = torch.load(checkpoint_path, map_location=self.device, weights_only=False)\n",
    "        model_config = checkpoint.get(\"model_config\", {\"model_size\": \"S\", \"patch_size\": 2})\n",
    "\n",
    "        # Initialize model\n",
    "        self.model = DiT(\n",
    "            in_channels=3,\n",
    "            image_size=32,\n",
    "            patch_size=model_config.get(\"patch_size\", 2),\n",
    "            model_size=model_config.get(\"model_size\", \"S\"),\n",
    "        ).to(self.device)\n",
    "        self.model.load_state_dict(checkpoint[\"model_state_dict\"])\n",
    "        self.model.eval()\n",
    "\n",
    "        # Initialize diffusion\n",
    "        self.diffusion = Diffusion(num_timesteps=1000, beta_schedule=\"cosine\", guidance_scale=7.5)\n",
    "\n",
    "        # Initialize CLIP\n",
    "        self.clip_encoder = CLIPTextEncoder()\n",
    "        self.clip_encoder.model.to(self.device)\n",
    "\n",
    "    def generate(self, prompt: str, num_samples: int = 4, num_steps: int = 50, seed: int = 42) -> list:\n",
    "        \"\"\"Generate images from a text prompt.\"\"\"\n",
    "        torch.manual_seed(seed)\n",
    "\n",
    "        # Encode text\n",
    "        with torch.no_grad():\n",
    "            text_embeds = self.clip_encoder.encode([prompt] * num_samples)\n",
    "        text_embeds = text_embeds.to(self.device)\n",
    "\n",
    "        # Start from noise\n",
    "        shape = (num_samples, 3, 32, 32)\n",
    "        x_t = torch.randn(shape, device=self.device)\n",
    "\n",
    "        # DDIM sampling\n",
    "        step_indices = torch.linspace(0, self.diffusion.num_timesteps - 1, num_steps + 1).long()\n",
    "        timesteps = torch.zeros(num_steps, dtype=torch.long, device=self.device)\n",
    "        for i, idx in enumerate(reversed(step_indices[:-1])):\n",
    "            timesteps[i] = idx if idx > 0 else self.diffusion.num_timesteps - 1\n",
    "\n",
    "        for t in tqdm(reversed(timesteps), desc=\"Sampling\"):\n",
    "            t_batch = torch.full((num_samples,), t.item(), device=self.device, dtype=torch.long)\n",
    "            x_t = self._ddim_step(x_t, t_batch, text_embeds)\n",
    "\n",
    "        # Convert to images\n",
    "        images = (x_t + 1.0) / 2.0\n",
    "        images = torch.clamp(images, 0.0, 1.0)\n",
    "        return images\n",
    "\n",
    "    def _ddim_step(self, x_t: torch.Tensor, timesteps: torch.Tensor, text_embeds: torch.Tensor) -> torch.Tensor:\n",
    "        \"\"\"DDIM sampling step.\"\"\"\n",
    "        t = timesteps.item()\n",
    "\n",
    "        with torch.no_grad():\n",
    "            predicted_noise = self.model(x_t, timesteps, text_embeds)\n",
    "\n",
    "        alpha_t = self.diffusion.alphas_cumprod[t]\n",
    "        alpha_t_1 = self.diffusion.alphas_cumprod[t - 1] if t > 0 else torch.tensor(1.0)\n",
    "        alpha_t = alpha_t.to(x_t.device)\n",
    "        alpha_t_1 = alpha_t_1.to(x_t.device)\n",
    "\n",
    "        pred_x_0 = torch.sqrt(alpha_t) * x_t - torch.sqrt(1 - alpha_t) * predicted_noise\n",
    "        pred_x_0 = torch.clamp(pred_x_0, -1.0, 1.0)\n",
    "\n",
    "        dir_xt = torch.sqrt(1 - alpha_t_1) * (x_t - pred_x_0 / torch.sqrt(alpha_t))\n",
    "        x_t_1 = pred_x_0 + dir_xt\n",
    "\n",
    "        return x_t_1\n",
    "\n",
    "\n",
    "def save_images(images: torch.Tensor, output_dir: str, prefix: str = \"sample\") -> None:\n",
    "    \"\"\"Save generated images to files.\"\"\"\n",
    "    os.makedirs(output_dir, exist_ok=True)\n",
    "    from PIL import Image\n",
    "\n",
    "    for i, img in enumerate(images):\n",
    "        img = img.permute(1, 2, 0).cpu().numpy()\n",
    "        img = (img * 255).astype(\"uint8\")\n",
    "        img = Image.fromarray(img)\n",
    "        path = os.path.join(output_dir, f\"{prefix}_{i}.png\")\n",
    "        img.save(path)\n",
    "        print(f\"Saved: {path}\")\n",
    "\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    import argparse\n",
    "\n",
    "    parser = argparse.ArgumentParser()\n",
    "    parser.add_argument(\"--prompt\", type=str, default=\"a cute robot\")\n",
    "    parser.add_argument(\"--num-samples\", type=int, default=4)\n",
    "    parser.add_argument(\"--checkpoint\", type=str, default=\"checkpoints/model_final.pt\")\n",
    "    parser.add_argument(\"--guidance-scale\", type=float, default=7.5)\n",
    "    parser.add_argument(\"--steps\", type=int, default=50)\n",
    "    parser.add_argument(\"--output-dir\", type=str, default=\"generated\")\n",
    "    args = parser.parse_args()\n",
    "\n",
    "    generator = Generator(args.checkpoint)\n",
    "    images = generator.generate(args.prompt, args.num_samples, args.steps)\n",
    "    save_images(images, args.output_dir, prefix=args.prompt.replace(\" \", \"_\"))\n",
    "\n",
    "\n",
    "print(\"✅ generate.py created\")"
   ]
  },
